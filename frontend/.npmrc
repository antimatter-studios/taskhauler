# Tell pnpm to write all supported platform variants of optional/native deps
# (rollup, esbuild, swc, lightningcss, ...) into pnpm-lock.yaml so CI on
# linux works fine even when devs run pnpm install on macOS.
supported-architectures.os=linux,darwin
supported-architectures.cpu=x64,arm64
supported-architectures.libc=glibc,musl

# Keep pnpm's strict peer-deps as warnings, not errors — we'll surface
# genuine issues but not break installs on noise.
strict-peer-dependencies=false
